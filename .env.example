# ==============================================================================
# WhatsApp Marketing SaaS - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: Never commit sensitive credentials or real secrets to version control.
# ==============================================================================

# Application Environment ('development' | 'test' | 'production')
NODE_ENV=development

# API Service Configuration
API_PORT=4000
API_HOST=0.0.0.0
API_PREFIX=/api/v1

# Frontend Web Application Configuration (Public / CORS)
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# Vite Public Environment Variables (Exposed to Browser)
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME="WhatsApp Marketing SaaS"
VITE_APP_ENV=development

# Database Configuration (MongoDB)
# Local development default without authentication (or see infrastructure/docker)
MONGODB_URI=mongodb://localhost:27017/whatsapp_saas_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Cache & Background Queue Configuration (Redis)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging Configuration ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Future Phase Placeholders (Documented for architectural reference - Not used in Phase 1)
# ------------------------------------------------------------------------------
# JWT Authentication Secrets (Phase 2)
# JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
# JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# Meta WhatsApp Business Cloud API (Phase 3)
# META_GRAPH_API_VERSION=v20.0
# META_APP_ID=your_meta_app_id_placeholder
# META_APP_SECRET=your_meta_app_secret_placeholder
# META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_placeholder

# Stripe / Billing Integration (Phase 5)
# STRIPE_SECRET_KEY=sk_test_placeholder
# STRIPE_WEBHOOK_SECRET=whsec_placeholder
