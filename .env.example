# ==============================================================================
# Pingza WhatsApp Marketing SaaS - Environment Configuration Template
# ==============================================================================
# Copy this template to .env for local development:
#   cp .env.example .env
#
# CRITICAL SECURITY RULE:
# Never commit real credentials, access tokens, API secrets, or private keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Environment
# ------------------------------------------------------------------------------
# Runtime environment: 'development' | 'test' | 'production'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. API Gateway Service Configuration
# ------------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 3. Frontend Web Application (CORS & Public Origins)
# ------------------------------------------------------------------------------
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# Client-Side Exposed Environment Variables (Vite - Safe for Browser)
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME="Pingza"
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 4. Database Configuration (MongoDB) [SECRET IN PRODUCTION]
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/whatsapp_saas_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 5. Distributed Queues & Cache (Redis) [SECRET IN PRODUCTION]
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 6. Authentication & Session Security [CRITICAL SECRETS]
# ------------------------------------------------------------------------------
# Secret for signing short-lived access tokens (min 32 characters)
JWT_ACCESS_SECRET=dev-jwt-access-secret-32-chars-long-min!!
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# 7. Meta WhatsApp Cloud API & Embedded Signup v4 [CRITICAL SECRETS]
# ------------------------------------------------------------------------------
# Supported Graph API version (must be configurable, defaults to v26.0)
META_GRAPH_API_VERSION=v26.0

# Meta App ID from Meta Developer Dashboard (Public identifier)
META_APP_ID=1113739574734996

# Meta App Secret (Used for server-side token exchange and HMAC-SHA256 signature verification)
# [CRITICAL SECRET - NEVER EXPOSE TO CLIENT]
META_APP_SECRET=219cc8bca8a0ea1bb2f3c7c34d44bc32

# Meta Embedded Signup v4 Configuration ID (Created in Meta App Dashboard under WhatsApp > Quickstart)
META_CONFIG_ID=default_embedded_signup_config_id

# Verification token for incoming GET challenge handshake from Meta
# [SECRET - Must match token configured in Meta App Webhook settings]
META_WEBHOOK_VERIFY_TOKEN=125a6a4a07364507e4b8057f4f78303f27854a99eb88f3a61c27a2285f2d5dea

# AES-256-GCM Master Key for Encrypting Meta Access Tokens at Rest in Database
# [CRITICAL SECRET - Exactly 32 bytes (64 hexadecimal characters)]
# Generate using: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=a7d2e947cf8e3c1a89b0d3e5271a4f89c02b5e7d91a348f6c1e95b7a32d1840e

# ------------------------------------------------------------------------------
# 8. Outbound Email & Notifications
# ------------------------------------------------------------------------------
EMAIL_FROM=noreply@pingza.local
