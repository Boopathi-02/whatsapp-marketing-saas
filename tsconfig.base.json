{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@whatsapp-saas/contracts": ["packages/contracts/dist/index.d.ts"],
      "@whatsapp-saas/contracts/*": ["packages/contracts/dist/*"],
      "@whatsapp-saas/domain": ["packages/domain/dist/index.d.ts"],
      "@whatsapp-saas/domain/*": ["packages/domain/dist/*"],
      "@whatsapp-saas/database": ["packages/database/dist/index.d.ts"],
      "@whatsapp-saas/database/*": ["packages/database/dist/*"],
      "@whatsapp-saas/whatsapp-adapter": ["packages/whatsapp-adapter/dist/index.d.ts"],
      "@whatsapp-saas/whatsapp-adapter/*": ["packages/whatsapp-adapter/dist/*"],
      "@whatsapp-saas/billing": ["packages/billing/dist/index.d.ts"],
      "@whatsapp-saas/billing/*": ["packages/billing/dist/*"]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
